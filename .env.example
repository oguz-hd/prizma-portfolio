# Bu dosyayı `.env` olarak kopyala ve doldur. `.env` git'e girmez (.gitignore).
#
#   cp .env.example .env

# Sitenin alan adı. Boş bırakılırsa Caddy :80 dinler (yerel deneme).
# Gerçek bir alan adı verilirse Let's Encrypt sertifikası otomatik alınır.
DOMAIN=

# Sertifika uyarılarının gideceği adres (Let's Encrypt zorunlu kılıyor).
ADMIN_EMAIL=

# --- API (Faz 5) — üretimde ZORUNLU ---
# İkisi de boş/varsayılan kalırsa API üretimde AÇILMAZ (api/app/main.py).
# JWT_SECRET üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Admin hesabı ilk açılışta (veritabanı boşken) bu parolayla kurulur.
# ⚠️ Sonradan değiştirmek hesabı değiştirmez — tohumlama yalnızca bir kez çalışır.
# Giriş e-postası yukarıdaki ADMIN_EMAIL.
ADMIN_PASSWORD=
