# Yayın sunucusu. docker-compose.prod.yml tarafından bağlanır.
#
# DOMAIN boşsa :80 dinlenir (yerel deneme). Gerçek alan adı verilirse Caddy
# sertifikayı kendisi alır ve yeniler — ek iş yok.

{
	email {$ADMIN_EMAIL:admin@localhost}
	# Bağlantıyı tutan yavaş istekler (başlığı/gövdeyi damla damla gönderen) sınırlı
	# yaşasın — varsayılanda süre yok (güvenlik taraması, Oturum 6). Gövde 2 dk: 15 MB
	# görsel yavaş bağlantıda da yetişsin.
	servers {
		timeouts {
			read_header 10s
			read_body 2m
			write 2m
			idle 2m
		}
	}
}

# ── Güvenlik başlıkları (yayına hazırlık, Oturum 6) — site ve panel ──
# Parça (snippet): hem normal yanıtlara hem handle_errors'a (404 sayfası) eklenmeli —
# hata yolu ayrı bir rota, sitenin `header`'ını almıyor (05.10.2026, ölçüldü).
# CSP: betik yalnızca kendi kökümüzden (ikisi de dış dosya); stil 'unsafe-inline'
# index.html'deki ilk boya <style>'ı ve React'in style özniteliği için. Görsel
# data: favicon için (theme/favicon.ts). frame-ancestors + X-Frame-Options: başka
# site çerçeveye alamaz — panelde görünmez çerçevede "Sil"e tıklatma yolu kapalı.
# HSTS yalnızca HTTPS'te geçerli (tarayıcı http'de yok sayar); :80 yerel denemeye zararsız.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# ── Proje sayfaları ──
# Her proje kendi deposundan yayına çıkar; bu depo onlara dokunmaz. Sunucuda
# /opt/sites/<ad> = o deponun `site` dalı (içinde Caddyfile + public/), konteynerde
# /srv/sites (docker-compose.prod.yml). Yeni proje: klasörü klonla + Caddy'yi yeniden yükle.
# Klasör yoksa ya da boşsa (yerel deneme) eşleşme yok, Caddy yalnızca uyarı yazar.
# → docs/CALISTIRMA.md "Proje sayfaları"
import /srv/sites/*/Caddyfile

{$DOMAIN::80} {
	root * /srv

	# Tiny Roamers 06.10.2026'da kendi alt alanına taşındı; eski yol oraya yönlensin.
	# (`uri strip_prefix` + `{uri}` olmuyor: redir ilk adresi yazıyor — denendi.)
	@tinyroamers path_regexp tr ^/tinyroamers(/.*)?$
	handle @tinyroamers {
		redir https://tinyroamers.oguzhd.com{re.tr.1} permanent
	}
	encode zstd gzip

	# API — yönetim paneli (Faz 7) ve sağlık kontrolü. Ziyaretçi sitesi API'ye
	# hiç gitmez; içeriği aşağıdaki dosyadan okur.
	handle /api/* {
		# Asıl sınır API'de (16 MB, api/app/limits.py — 413'ü o veriyor). Buradaki
		# dış pay ondan BÜYÜK olmalı: eşit olunca Caddy gövdeyi tam sınırda kesiyor, API
		# devamını bekliyor, bağlantı asılı kalıyordu (güvenlik taraması, Oturum 6).
		request_body {
			max_size 20MB
		}
		reverse_proxy api:8000 {
			transport http {
				# API yanıt vermezse (takılan istek) bağlantı sonsuza dek tutulmasın.
				response_header_timeout 2m
			}
		}
	}

	# ⚠️ Veri volume'u /srv/data'da — meta şablonu (/data/meta.html) kökten okuyor,
	# taşınamıyor. Ama HTTP'den ASLA: aşağıdaki SPA bloğu /srv'yi sunduğu için
	# /data/site.db (admin parola hash'i dahil) ve göç yedekleri indirilebiliyordu
	# (Oturum 6, yayına hazırlıkta bulundu). Dışarı yalnızca content.json ve uploads.
	handle /data/* {
		respond 404
	}

	# ★ İçerik paylaşılan volume'dan okunuyor, imajın içinden değil.
	# API her değişiklikte buraya yazıyor (api/app/publish.py); site yalnızca bu
	# dosyayı çekiyor — veritabanı sorgusu yok, statik site hızı (docs/ARCHITECTURE.md § 3).
	handle /content.json {
		root * /srv/data
		# Her açılışta doğrulansın (ETag → değişmediyse 304): panelden gelen
		# değişiklik bir sonraki açılışta görünür, eski kopya takılı kalmaz.
		header Cache-Control "no-cache"
		file_server
	}

	# Panelden yüklenen görseller (Faz 9). Adlar rastgele ve değişmez (api/app/media.py):
	# görsel değişince yeni ad alıyor → sonsuza kadar önbelleklenebilir.
	handle /uploads/* {
		root * /srv/data
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Değişmez varlıklar: Vite bunları içerik hash'iyle adlandırıyor,
	# dolayısıyla uzun süre önbelleklenebilirler.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# ── Yönetim paneli (Faz 7b) — ayrı build, /srv/admin (web/Dockerfile) ──
	# Ziyaretçi sitesi bu kodu hiç indirmiyor. Sayfalar #'te (/admin/#profil),
	# yani tek bir index.html yetiyor.
	redir /admin /admin/
	handle /admin/assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /admin/* {
		header Cache-Control "no-cache"
		# Panel arama sonuçlarında görünmesin (robots.txt'te engellenmiyor — bkz. orası).
		header X-Robots-Tag "noindex, nofollow"
		try_files {path} /admin/index.html
		file_server
	}

	# Keşif dosyaları (api/app/discovery.py): API her yayında yazıyor. sitemap.xml
	# yalnızca alan adı varken var — yoksa aşağıdaki 404.
	@discovery path /robots.txt /sitemap.xml /llms.txt
	handle @discovery {
		root * /srv/data
		header Cache-Control "no-cache"
		file_server
	}

	# Site tek sayfa: yalnızca kök (slaytlar #hash'te) ve imajdaki gerçek dosyalar
	# (fontlar). Başka her yol GERÇEK 404 — eskiden index.html 200'le dönüyordu,
	# arama motoru her uydurma adresi ayrı sayfa sanıyordu (soft-404). 404 sayfasını
	# yine site çiziyor (web/src/route.ts → isNotFound), aşağıdaki handle_errors'la.
	handle {
		# ★ Meta etiketleri (<title>, og:*) yayın anında içerikten: index.html'deki
		# şablon /data/meta.html'i okuyor (web/vite.config.ts → metaFromContent).
		templates @html
		file_server
	}

	# 404 → aynı index.html, durum kodu 404 kalarak. Site yolu okuyup 404 ekranını
	# (404 nm) gösteriyor. Panelin yolları yukarıda try_files'la, buraya düşmüyor.
	handle_errors 404 {
		import security_headers
		rewrite * /index.html
		templates
		header Cache-Control "no-cache"
		file_server
	}

	# index.html asla önbelleklenmemeli — yeni yayın anında görünsün.
	@html path /index.html /
	header @html Cache-Control "no-cache"

	import security_headers
}
